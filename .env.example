# Polygon.io API Configuration
POLYGON_API_KEY=your_polygon_api_key_here

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Data Configuration
DATA_PROVIDER=polygon  # Options: polygon, quantconnect, mock
CACHE_ENABLED=True
CACHE_TTL=3600
